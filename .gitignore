# Unity gitignore
# Covers root and subdirectories

[Ll]ibrary/
**/[Ll]ibrary/
[Tt]emp/
**/[Tt]emp/
[Oo]bj/
**/[Oo]bj/
[Bb]uild/
**/[Bb]uild/
[Bb]uilds/
**/[Bb]uilds/
[Ll]ogs/
**/[Ll]ogs/
[Uu]ser[Ss]ettings/
**/[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
**/[Mm]emoryCaptures/
[Rr]ecordings/
**/[Rr]ecordings/

# Visual Studio / IDE / Build cache
.vs/
**/.vs/
.utmp/
**/.utmp/
.gradle/
**/.gradle/
ExportedObj/
.consulo/

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity generated meta files that shouldn't be tracked
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Builds
*.apk
*.aab
*.app

# OS generated
.DS_Store
Thumbs.db
